[Unit]
Description=DigitalFootprint local SearXNG search service
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/digitalfootprint/deploy/searxng
ExecStart=/usr/bin/docker compose --project-name digitalfootprint-search --env-file /etc/digitalfootprint/searxng.env -f compose.native.yaml up -d --wait
ExecStop=/usr/bin/docker compose --project-name digitalfootprint-search --env-file /etc/digitalfootprint/searxng.env -f compose.native.yaml down
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
