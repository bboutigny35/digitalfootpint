DIGITALFOOTPRINT_ENVIRONMENT=development
DIGITALFOOTPRINT_DATABASE_URL=sqlite:///./digitalfootprint.db
DIGITALFOOTPRINT_SECRET_KEY=replace-with-at-least-32-random-characters
DIGITALFOOTPRINT_ALLOWED_HOSTS=localhost,127.0.0.1
DIGITALFOOTPRINT_CORS_ORIGINS=http://127.0.0.1:5173
DIGITALFOOTPRINT_COOKIE_SECURE=false
DIGITALFOOTPRINT_SESSION_TTL_HOURS=12
DIGITALFOOTPRINT_HTTP_PORT=8080
DIGITALFOOTPRINT_SENSITIVE_RETENTION_INTERVAL_SECONDS=86400
DIGITALFOOTPRINT_SCAN_WORKER_POLL_SECONDS=2
# Facultatif : jeton GitHub à permissions minimales pour relever les quotas API.
DIGITALFOOTPRINT_GITHUB_API_TOKEN=
# SearXNG intégré (Compose avec overlay) : aucun jeton tiers à configurer.
DIGITALFOOTPRINT_SEARXNG_URL=
SEARXNG_SECRET=
# Facultatif : jeton Brave Search API. Les requêtes sélectionnées transmettent
# noms/pseudonymes au fournisseur et peuvent être facturées selon le plan.
DIGITALFOOTPRINT_BRAVE_API_TOKEN=
# Laisser à false sans avis juridique et droits contractuels compatibles avec la
# persistance des résultats. Une clé seule ne rend pas le connecteur prêt.
DIGITALFOOTPRINT_BRAVE_CONTRACT_APPROVED=false
# Coffre administrable : clé AES-256 encodée en base64 URL-safe et version active.
# Génération : python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
DIGITALFOOTPRINT_CONNECTOR_SECRET_KEYS=
DIGITALFOOTPRINT_CONNECTOR_SECRET_ACTIVE_KEY=

# Déploiement Compose PostgreSQL uniquement. Ne versionnez jamais les vraies valeurs.
POSTGRES_DB=digitalfootprint
POSTGRES_USER=digitalfootprint
POSTGRES_PASSWORD=replace-with-a-long-random-password
COMPOSE_POSTGRES_DATABASE_URL=postgresql+psycopg://digitalfootprint:replace-with-a-long-random-password@postgres:5432/digitalfootprint
